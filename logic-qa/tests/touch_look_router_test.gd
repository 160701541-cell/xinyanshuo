extends SceneTree
const Router = preload("res://scripts/touch_look_router.gd")

func _initialize() -> void:
	var r = Router.new()
	var screen := Vector2(1280,720)
	assert(not r.begin(0, Vector2(160,550), screen, 0.0), "Joystick finger cannot capture camera")
	assert(r.begin(1, Vector2(1000,350), screen, 1.0))
	assert(r.move(1, Vector2(1005,354)).is_empty(), "Jitter must not move camera")
	var drag: Dictionary = r.move(1, Vector2(1070,390))
	assert(drag["action"] == "look")
	assert(drag["delta"] == Vector2(65,36))
	assert(r.end(1, Vector2(1070,390),1.16)["action"] == "end", "Dragging cannot trigger scene ray touch")
	assert(r.begin(2, Vector2(850,450),screen, 4.0))
	assert(r.end(2, Vector2(852,452),4.1)["action"] == "tap")
	assert(not r.is_looking())
	assert(r.begin(3, Vector2(850,420),screen,5.0))
	assert(r.begin(4, Vector2(1070,420),screen,5.0))
	var pinch: Dictionary = r.move(4, Vector2(1160,420))
	assert(pinch["action"] == "zoom" and pinch["factor"] < 1.0, "Two right fingers pinch to zoom")
	assert(r.end(4,Vector2(1160,420),5.1)["action"] == "end")
	assert(r.move(3,Vector2(851,420))["action"] == "look" or r.is_looking(),
		"After pinch only right-hand ownership remains")
	r.end(3,Vector2(850,420),5.15)
	assert(not r.is_looking())
	var portrait := Vector2(720,1280)
	assert(not r.begin(5,Vector2(200,900),portrait,0.0))
	assert(r.begin(6,Vector2(600,700),portrait,0.0))
	assert(r.move(6,Vector2(600,620))["action"] == "look")
	r.clear()
	assert(not r.is_looking())
	print("PASS combat touch router: isolated left movement, continuous right look, jitter filtering, pinch, portrait ownership, no accidental world taps")
	quit(0)
