<Project Sdk="Microsoft.NET.Sdk">
  <!-- References are downloaded transiently from WorldBoxOpenMods/AndroidModLoader,
       never checked in, never packaged into an APK. Exact Android 0.51.4 compatibility still unverified. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>XianxiaObserverMobileSDKProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../nml-observer-v07/Code/XianxiaObserverV07.cs" />
    <Compile Include="../huge-map-mod/GiantMapOptionsV11.cs" />
    <Compile Include="../huge-map-mod/ObserverFrameGuardV12.cs" />
    <Compile Include="../ui/ModTextAccessibilityV13.cs" />
    <Compile Include="../gameplay/CultivationV18.cs" />
    <Compile Include="../ui/ChineseModManagerV21.cs" />
    
    <Reference Include="NeoModLoader_mobile"><HintPath>$(AndroidSdkPath)/NeoModLoader_mobile.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(AndroidSdkPath)/UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(AndroidSdkPath)/UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(AndroidSdkPath)/UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(AndroidSdkPath)/Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(AndroidSdkPath)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2CppInterop.Runtime"><HintPath>$(AndroidSdkPath)/Il2CppInterop.Runtime.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Il2Cppmscorlib"><HintPath>$(AndroidSdkPath)/Il2Cppmscorlib.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
