extends SceneTree
const Paving = preload("res://scripts/stone_road.gd")
## Real Godot contract test. No network calls and no Android/release claims.
func _initialize() -> void:
	call_deferred("_run")

func _run() -> void:
	var packed: PackedScene = load("res://scenes/village.tscn")
	assert(packed != null, "Godot stage unavailable")
	var stage: Node2D = packed.instantiate()
	root.add_child(stage)
	assert(stage.is_node_ready(), "Scene failed to enter tree")
	var camera: Camera2D = stage.get_node_or_null("Camera2D")
	assert(camera != null and camera.is_current(), "Camera2D invalid")
	assert(camera.zoom.x>0.0 and camera.zoom.x<2.0, "Camera zoom invalid")
	assert(stage.get("_status") is Label, "Status UI missing")
	var city: Node2D = stage.get_node_or_null("ProceduralCity")
	assert(city != null, "Procedural city missing")
	var stats: Dictionary = city.call("counts")
	print("PROCEDURAL_WORLD_COUNTS:",stats)
	assert(int(stats["plots"]) == 24, "Courtyard map must contain 24 plots")
	assert(int(stats["buildings"]) >= 50, "Too few truly instantiated buildings")
	assert(int(stats["props"]) >= 100, "Props must exist as individual entities")
	assert(int(stats["entities"]) == int(stats["buildings"])+int(stats["props"]), "Duplicate world entity IDs")
	# Reuse Godot's native MIT implementations instead of shipping unvetted plugins.
	var oss_stats: Dictionary = city.call("oss_component_stats")
	assert(oss_stats.get("noise") == "Godot FastNoiseLite", "Native noise unavailable")
	assert(oss_stats.get("navigation") == "Godot AStarGrid2D", "Native navigation unavailable")
	assert(int(oss_stats["blocked_cells"]) > 100, "No real obstacle-aware A* map")
	assert(not bool(city.call("walkable_at",Vector2(1500,2350))), "River falsely walkable")
	var crossing: PackedVector2Array = city.call("navigation_path",Vector2(1050,2100),Vector2(1050,2610))
	assert(crossing.size()>2, "Godot A* route over open bridge unavailable")
	var biome_a: float = float(city.call("biome_at",Vector2(1587,347)))
	assert(absf(biome_a) <= 1.0, "Noise sample outside expected range")

	var road: Node = city.get_node_or_null("SeamlessStoneRoad")
	assert(road != null and road.get_child_count() == 14, "Paving missing")
	var img: Image = Paving.make_image()
	assert(img.get_width()==256 and Paving.edges_match(img), "Road seam failed")
	var houses: Array[Node2D] = city.get("buildings")
	var first: Node2D = houses[0]
	var id: String = String(first.get("entity_id"))
	assert(city.call("get_entity",id)==first, "Entity-index mapping broken")
	assert(not bool(first.get("door_open")), "Door not closed by default")
	first.call("toggle_door")
	assert(bool(first.get("door_open")), "Door did not open")
	first.call("toggle_door")
	assert(not bool(first.get("door_open")), "Door did not close")
	first.call("set_damage",1)
	assert(int(first.get("damage"))==1, "Damage state not applied")
	first.call("set_damage",0)
	var first_prop: Node2D = city.get("props")[0]
	city.call("set_season",2)
	assert(int(first_prop.get("season"))==2, "Season didn't propagate")
	city.call("set_night",true)
	assert(bool(first_prop.get("night")), "Night didn't propagate to props")
	assert(bool(first.get("lantern_lit")), "Night didn't light building lanterns")
	stage.call("_select_building",first)
	stage.call("_enter_selected")
	assert(bool(stage.get("_inside")), "Cannot enter selected actual building")
	var interior: Node2D = stage.get_node_or_null("ProceduralInterior")
	assert(interior != null and interior.visible, "Interior missing")
	assert(String(interior.get("source_building_id"))==id, "Interior not paired to exterior ID")
	var furniture: Array[Node2D] = interior.get("furnishings")
	assert(furniture.size()>=5, "No individually instanced room furnishings")
	stage.call("_leave_interior")
	assert(not bool(stage.get("_inside")) and city.visible, "Could not leave room")
	city.call("generate",1729)
	var again: Dictionary = city.call("counts")
	assert(again == stats, "Seeded regeneration not deterministic")
	assert(is_equal_approx(float(city.call("biome_at",Vector2(1587,347))),biome_a),
		"FastNoiseLite seed is not reproducible")
	stage.call("_zoom",1.2)
	assert(camera.zoom.x>0.9, "Camera zoom handler broken")
	print("PASS PUBLIC HD2D GODOT SCENE STARTUP: procedural districts, 50+ buildings, 100+ entities, doors, damage, seasons, interior, paving, camera")
	stage.queue_free()
	quit(0)
